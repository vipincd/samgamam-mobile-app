{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --testPathIgnorePatterns=.*real-backend.*",
    "test:integration": "jest --runInBand src/api/client-real-backend.test.ts",
    "security:audit": "node scripts/security-audit.cjs",
    "test:contracts": "node --test tests/api/*.test.cjs tests/security/*.test.cjs tests/isolation/*.test.cjs",
    "test:maestro": "node scripts/testing/run-maestro.mjs",
    "test:android:acceptance": "node scripts/testing/mock-manager.cjs exec --platform android -- node scripts/testing/run-maestro.mjs",
    "test:maestro:ios": "bash scripts/testing/ios-acceptance.sh",
    "test:mock": "node scripts/testing/mock-api.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.18",
    "expo-camera": "~58.0.13",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.10",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.44.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-auth0": "5.11.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "undici": "^7.30.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "\\.cjs$"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "caller": {
            "name": "metro",
            "bundler": "metro",
            "platform": "ios",
            "preserveEnvVars": true
          },
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  },
  "private": true,
  "overrides": {
    "shell-quote": "^1.12.0",
    "postcss": "^8.5.10",
    "@babel/core": "7.29.6",
    "react-native": "$react-native"
  }
}
