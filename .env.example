# Public identifiers for a local native development build. Never add a client secret.
EXPO_PUBLIC_AUTH0_DOMAIN=your-development-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-native-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.dev.example.invalid

# Android Emulator reaches the host through 10.0.2.2. Use the appropriate host for a real device.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
