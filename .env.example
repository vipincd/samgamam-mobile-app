# Local backend. Android Emulator users can substitute http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public development identifiers. Supply all three together; never add a client secret.
EXPO_PUBLIC_AUTH0_DOMAIN=your-development-tenant.example.invalid
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-public-native-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.example.invalid
